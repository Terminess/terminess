#!/usr/bin/env bash
# pair: hand work between Claude Code and Codex from whichever one is the main session.
#
#   pair ask     [claude|codex] [opts] "question"     other agent answers, read-only
#   pair handoff [claude|codex] [opts] "task"         other agent does the work, may edit files
#   pair review  [claude|codex] [opts] ["focus"]      other agent reviews uncommitted changes
#   pair log     [N]                                  show the last N ledger entries (default 10)
#
# Parallel (other agent works in its own git worktree while you carry on):
#   pair parallel [claude|codex] [opts] "task"        start in the background, print a job id
#   pair status                                       list parallel jobs
#   pair wait    [ID|last]                            block until done, show report and diffstat
#   pair diff    [ID|last]                            show the worker's full patch
#   pair apply   [ID|last]                            apply its changes to your tree (uncommitted)
#   pair discard [ID|last]                            throw the work away
#
# Options:
#   --fix             (review) let the reviewer fix what it finds
#   --base BRANCH     (review) review against BRANCH instead of uncommitted changes
#   --continue        resume the last session with that agent in this repo
#   --brief-file F    read the brief from file F (use - for stdin)
#   --transcript F    main session transcript to point the other agent at
#   --from claude|codex  who is calling (normally auto-detected)
#
# Target defaults to "the other one". Runs are recorded in ~/.local/state/pair/.
# Compatible with macOS bash 3.2.

set -euo pipefail

command -v jq >/dev/null 2>&1 || { echo "pair: needs jq, which comes with macOS 15 and later. On older macOS: brew install jq" >&2; exit 1; }

STATE="${PAIR_STATE:-$HOME/.local/state/pair}"
LEDGER="$STATE/log.jsonl"
mkdir -p "$STATE/runs"

die() { echo "pair: $*" >&2; exit 1; }

usage() { sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

PAR="$STATE/parallel"

resolve_job() {
  local id="${1:-last}"
  if [ "$id" = "last" ]; then id="$(ls -1 "$PAR" 2>/dev/null | sort | tail -n1)"; fi
  [ -n "$id" ] && [ -d "$PAR/$id" ] || die "no such parallel job: ${1:-last} (see: pair status)"
  echo "$id"
}

job_state() { # prints running / done / failed / died / applied / discarded
  local P="$PAR/$1"
  if [ -f "$P/state" ]; then cat "$P/state"; return; fi
  if [ -f "$P/exit" ]; then
    if [ "$(cat "$P/exit")" = "0" ]; then echo done; else echo failed; fi; return
  fi
  if [ -f "$P/pid" ] && kill -0 "$(cat "$P/pid")" 2>/dev/null; then echo running; else echo died; fi
}

meta() { sed -n "s/^$2=//p" "$PAR/$1/meta" | head -n1; }

make_patch() {
  local P="$PAR/$1" WT; WT="$(meta "$1" wt)"
  [ -d "$WT" ] || die "worktree for $1 is gone"
  local EXCL=()
  while IFS= read -r p; do [ -n "$p" ] && EXCL+=(":(exclude)$p"); done < "$P/linked.txt"
  ( cd "$WT"
    git add -A -- . ${EXCL[@]+"${EXCL[@]}"}
    git diff --cached --binary "$(cat "$P/base_tree")" > "$P/worker.patch"
    git diff --cached --stat "$(cat "$P/base_tree")" > "$P/worker.stat"
    git reset -q )
}

remove_worktree() {
  local REPO WT; REPO="$(meta "$1" repo)"; WT="$(meta "$1" wt)"
  [ -d "$WT" ] && git -C "$REPO" worktree remove --force "$WT" 2>/dev/null || rm -rf "$WT"
  git -C "$REPO" worktree prune 2>/dev/null || true
}

[ $# -ge 1 ] || usage 1
MODE="$1"; shift
case "$MODE" in
  ask|handoff|review|parallel) ;;
  status)
    [ -d "$PAR" ] && [ -n "$(ls -A "$PAR" 2>/dev/null)" ] || { echo "No parallel jobs."; exit 0; }
    for id in $(ls -1 "$PAR" | sort); do
      printf '%-24s %-10s %-7s %-16s %s\n' "$id" "$(job_state "$id")" "$(meta "$id" target)" \
        "$(basename "$(meta "$id" repo)")" "$(meta "$id" brief_head | cut -c1-70)"
    done
    exit 0 ;;
  wait)
    id="$(resolve_job "${1:-last}")"
    while [ "$(job_state "$id")" = "running" ]; do sleep 5; done
    st="$(job_state "$id")"
    echo "===== parallel job $id: $st ====="
    cat "$PAR/$id/output.log" 2>/dev/null || true
    if [ "$st" = "done" ] || [ "$st" = "failed" ]; then
      make_patch "$id"
      echo; echo "===== worker changes (pair diff $id to see them, pair apply $id to take them) ====="
      if [ -s "$PAR/$id/worker.patch" ]; then cat "$PAR/$id/worker.stat"; else echo "(no changes)"; fi
    fi
    [ "$st" = "done" ]; exit 0 ;;
  diff)
    id="$(resolve_job "${1:-last}")"
    make_patch "$id"; cat "$PAR/$id/worker.patch"; exit 0 ;;
  apply)
    id="$(resolve_job "${1:-last}")"
    st="$(job_state "$id")"
    case "$st" in done|failed) ;; *) die "job $id is $st; nothing to apply" ;; esac
    make_patch "$id"
    REPO="$(meta "$id" repo)"; PATCH="$PAR/$id/worker.patch"
    if [ ! -s "$PATCH" ]; then echo "Job $id made no changes."; remove_worktree "$id"; echo applied > "$PAR/$id/state"; exit 0; fi
    cd "$REPO"
    if git apply --check --binary "$PATCH" 2>/dev/null; then
      git apply --binary "$PATCH"
      echo "Applied job $id to $REPO (uncommitted):"; cat "$PAR/$id/worker.stat"
    else
      WT="$(meta "$id" wt)"; BASE_TREE="$(cat "$PAR/$id/base_tree")"
      TMP="$(mktemp -d)"; CONFLICTS=""; SKIPPED=""
      git apply --numstat "$PATCH" | cut -f3 | while IFS= read -r f; do echo "$f"; done > "$TMP/files"
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        if git -C "$WT" cat-file -e "$BASE_TREE:$f" 2>/dev/null; then
          git -C "$WT" show "$BASE_TREE:$f" > "$TMP/base"
        else : > "$TMP/base"; fi
        if [ ! -e "$WT/$f" ]; then                      # worker deleted it
          if [ -e "$f" ] && cmp -s "$f" "$TMP/base"; then rm -f "$f"; else CONFLICTS="$CONFLICTS $f(deleted-by-worker)"; fi
          continue
        fi
        if [ ! -e "$f" ]; then mkdir -p "$(dirname "$f")"; cp -p "$WT/$f" "$f"; continue; fi   # new file
        if git merge-file -L yours -L base -L "$(meta "$id" target)" "$f" "$TMP/base" "$WT/$f" 2>/dev/null; then :
        else
          rc=$?
          if [ $rc -gt 0 ] && [ $rc -lt 128 ]; then CONFLICTS="$CONFLICTS $f"; else SKIPPED="$SKIPPED $f"; fi
        fi
      done < "$TMP/files"
      rm -rf "$TMP"
      echo "Merged job $id into $REPO (uncommitted) with a three-way merge:"; cat "$PAR/$id/worker.stat"
      if [ -n "$SKIPPED" ]; then
        die "could not merge (binary?):$SKIPPED. Worktree kept at $WT for manual copying."
      fi
      if [ -n "$CONFLICTS" ]; then
        echo "CONFLICTS to resolve (look for <<<<<<< yours / >>>>>>> markers):$CONFLICTS"
        remove_worktree "$id"; echo applied > "$PAR/$id/state"
        exit 3
      fi
    fi
    remove_worktree "$id"; echo applied > "$PAR/$id/state"
    exit 0 ;;
  discard)
    id="$(resolve_job "${1:-last}")"
    [ "$(job_state "$id")" = "running" ] && kill "$(cat "$PAR/$id/pid")" 2>/dev/null || true
    remove_worktree "$id"; echo discarded > "$PAR/$id/state"
    echo "Discarded job $id."; exit 0 ;;
  log)
    n="${1:-10}"
    [ -f "$LEDGER" ] || { echo "No runs yet."; exit 0; }
    tail -n "$n" "$LEDGER" | jq -r '"\(.ts)  \(.from) -> \(.to)  \(.mode)  \(.repo | split("/") | last)  [\(.status)]\n    \(.brief_head)\n    result: \(.result_file)"'
    exit 0 ;;
  -h|--help|help) usage 0 ;;
  *) die "unknown mode '$MODE' (ask, handoff, review, parallel, status, wait, diff, apply, discard, log)" ;;
esac

TARGET=""; FROM=""; FIX=0; BASE=""; CONTINUE=0; BRIEF_FILE=""; TRANSCRIPT=""
PROMPT_PARTS=()
if [ $# -ge 1 ] && { [ "$1" = "claude" ] || [ "$1" = "codex" ]; }; then TARGET="$1"; shift; fi
while [ $# -gt 0 ]; do
  case "$1" in
    --fix) FIX=1 ;;
    --base) BASE="${2:?--base needs a branch}"; shift ;;
    --continue) CONTINUE=1 ;;
    --brief-file) BRIEF_FILE="${2:?--brief-file needs a path}"; shift ;;
    --transcript) TRANSCRIPT="${2:?--transcript needs a path}"; shift ;;
    --from) FROM="${2:?--from needs claude or codex}"; shift ;;
    -h|--help) usage 0 ;;
    *) PROMPT_PARTS+=("$1") ;;
  esac
  shift
done

if [ -z "$FROM" ]; then
  if [ "${CLAUDECODE:-}" = "1" ]; then FROM="claude"
  elif env | grep -q '^CODEX_'; then FROM="codex"
  else FROM="user"; fi
fi
if [ -z "$TARGET" ]; then
  case "$FROM" in
    claude) TARGET="codex" ;;
    codex) TARGET="claude" ;;
    *) die "can't tell who is calling; name the target: pair $MODE claude|codex ..." ;;
  esac
fi
[ "$TARGET" != "$FROM" ] || die "target and caller are both $TARGET"
command -v "$TARGET" >/dev/null || die "$TARGET CLI not found on PATH"

BRIEF=""
if [ -n "$BRIEF_FILE" ]; then
  if [ "$BRIEF_FILE" = "-" ]; then BRIEF="$(cat)"; else BRIEF="$(cat "$BRIEF_FILE")"; fi
fi
if [ ${#PROMPT_PARTS[@]} -gt 0 ]; then
  BRIEF="${BRIEF:+$BRIEF

}${PROMPT_PARTS[*]}"
fi
if [ -z "$BRIEF" ] && [ "$MODE" != "review" ]; then die "no brief given"; fi

REPO="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO"
IS_GIT=0; git rev-parse --git-dir >/dev/null 2>&1 && IS_GIT=1
[ "$MODE" = "review" ] && [ $IS_GIT -eq 0 ] && die "review needs a git repo"

if [ -z "$TRANSCRIPT" ]; then
  if [ "$FROM" = "claude" ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    TRANSCRIPT="$(find "$HOME/.claude/projects" -name "${CLAUDE_CODE_SESSION_ID}.jsonl" 2>/dev/null | head -n1 || true)"
  elif [ "$FROM" = "codex" ] && [ -d "$HOME/.codex/sessions" ]; then
    TRANSCRIPT="$(find "$HOME/.codex/sessions" -name 'rollout-*.jsonl' -mmin -120 -print0 2>/dev/null \
      | xargs -0 ls -t 2>/dev/null | head -n1 || true)"
  fi
fi

if [ "$MODE" = "parallel" ]; then
  [ $IS_GIT -eq 1 ] || die "parallel needs a git repo"
  git rev-parse --verify -q HEAD >/dev/null || die "parallel needs at least one commit"
  ID="$(date +%Y%m%d-%H%M%S)-$TARGET"
  P="$PAR/$ID"; WT="$STATE/worktrees/$(basename "$REPO")-$ID"
  mkdir -p "$P" "$STATE/worktrees"
  git worktree add -q --detach "$WT" HEAD

  git diff HEAD --binary > "$P/dirty.patch"
  [ -s "$P/dirty.patch" ] && git -C "$WT" apply --binary "$P/dirty.patch"
  git ls-files --others --exclude-standard -z | while IFS= read -r -d '' f; do
    mkdir -p "$WT/$(dirname "$f")"; cp -p "$f" "$WT/$f"
  done

  : > "$P/linked.txt"
  find . -maxdepth 3 \( -name node_modules -o -name .venv -o -name venv \) -type d -prune -not -path './.git/*' 2>/dev/null \
    | sed 's|^\./||' | while IFS= read -r d; do
      if [ -d "$WT/$(dirname "$d")" ] && [ ! -e "$WT/$d" ]; then ln -s "$REPO/$d" "$WT/$d"; echo "$d" >> "$P/linked.txt"; fi
    done
  find . -maxdepth 3 -name '.env*' -type f -not -path '*/node_modules/*' -not -path './.git/*' 2>/dev/null \
    | sed 's|^\./||' | while IFS= read -r f; do
      if git check-ignore -q -- "$f" && [ -d "$WT/$(dirname "$f")" ] && [ ! -e "$WT/$f" ]; then cp -p "$f" "$WT/$f"; fi
    done

  EXCL=(); while IFS= read -r p; do [ -n "$p" ] && EXCL+=(":(exclude)$p"); done < "$P/linked.txt"
  ( cd "$WT" && git add -A -- . ${EXCL[@]+"${EXCL[@]}"} && git write-tree > "$P/base_tree" && git reset -q )

  printf '%s\n' "$BRIEF" > "$P/brief.md"
  {
    echo "repo=$REPO"; echo "wt=$WT"; echo "target=$TARGET"; echo "from=$FROM"
    echo "started=$(date +%Y-%m-%dT%H:%M:%S)"
    echo "brief_head=$(printf '%s' "$BRIEF" | head -n1 | cut -c1-140)"
  } > "$P/meta"

  TARG=""; [ -n "$TRANSCRIPT" ] && TARG="--transcript $(printf '%q' "$TRANSCRIPT")"
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  {
    echo "cd $(printf '%q' "$WT") || exit 1"
    echo "export PAIR_RUN_DIR=$(printf '%q' "$P/run") PAIR_MAIN_REPO=$(printf '%q' "$REPO") PAIR_PARALLEL_ID=$(printf '%q' "$ID")"
    echo "$(printf '%q' "$SELF") handoff $TARGET --from $FROM --brief-file $(printf '%q' "$P/brief.md") $TARG > $(printf '%q' "$P/output.log") 2>&1 < /dev/null"
    echo "echo \$? > $(printf '%q' "$P/exit")"
  } > "$P/run.sh"
  nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' /bin/bash "$P/run.sh" > /dev/null 2>&1 < /dev/null &
  echo $! > "$P/pid"
  disown 2>/dev/null || true

  echo "pair: started parallel job $ID ($FROM -> $TARGET) in $WT"
  echo "pair: carry on; check with 'pair status', collect with 'pair wait $ID', then 'pair apply $ID' or 'pair discard $ID'"
  exit 0
fi

RESUME_ID=""
if [ $CONTINUE -eq 1 ] && [ -f "$LEDGER" ]; then
  RESUME_ID="$(jq -r --arg r "$REPO" --arg t "$TARGET" \
    'select(.repo==$r and .to==$t and .session_id!=null and .session_id!="") | .session_id' "$LEDGER" | tail -n1)"
  [ -n "$RESUME_ID" ] || echo "pair: no earlier $TARGET session for this repo, starting fresh" >&2
fi

WRITE=0
[ "$MODE" = "handoff" ] && WRITE=1
[ "$MODE" = "review" ] && [ $FIX -eq 1 ] && WRITE=1

cap() { echo "$1" | awk '{print toupper(substr($0,1,1)) substr($0,2)}'; }
CALLER_NAME="$(cap "$FROM")"; [ "$FROM" = "user" ] && CALLER_NAME="The user"

if [ "$MODE" = "review" ]; then
  if [ -n "$BASE" ]; then SCOPE="the changes on this branch against \`$BASE\` (\`git diff $BASE...HEAD\`)"
  else SCOPE="the uncommitted changes (\`git diff HEAD\` plus untracked files from \`git status\`)"; fi
  TASK="Review $SCOPE for real defects: correctness bugs, regressions, security problems, broken edge cases, missing or wrong tests. Check call sites and tests to confirm each finding before reporting it. Skip style nitpicks."
  if [ $FIX -eq 1 ]; then
    TASK="$TASK Then fix each confirmed finding directly, keeping changes minimal, and run the relevant tests."
  else
    TASK="$TASK Report findings ranked most severe first, each with file:line, what goes wrong, and the fix."
  fi
  [ -n "$BRIEF" ] && TASK="$TASK

Focus from the main session:
$BRIEF"
else
  TASK="$BRIEF"
fi

if [ -n "${PAIR_PARALLEL_ID:-}" ]; then
  ACCESS="You are working in an isolated git worktree copy of the repo, so edit files and run builds and tests freely here. The main session is working in parallel in the original copy and will review and apply your changes afterwards. Dependency folders such as node_modules or .venv are symlinked from the main copy: do not install, upgrade or remove packages; if a new dependency is needed, say so in your report."
elif [ $WRITE -eq 1 ]; then
  ACCESS="You have write access: edit files and run builds and tests in this repo as needed. The main session is waiting and will not touch files until you finish."
else
  ACCESS="Read-only: do not modify any files. Read code, run read-only commands, and answer."
fi

CTX="- Repo: $REPO. Follow its CLAUDE.md / AGENTS.md.
- Operator rules: the hard rules in ~/github/OPERATIONS.md apply."
[ -n "$TRANSCRIPT" ] && CTX="$CTX
- The main session's transcript is at $TRANSCRIPT (JSONL, newest at the end). Read the recent part only if the brief leaves something unclear."

PROMPT="You are $(cap "$TARGET"), paired with $CALLER_NAME, which is the user's main session in this repo. It has handed you the work below.

Context:
$CTX

$ACCESS

Never commit, push, deploy, touch production servers, or run migrations against anything but local test databases. Never use em dashes or en dashes. Never add AI attribution anywhere.

Finish with a concise report for the main session: what you did or found, files changed (if any), and anything unresolved or needing the user's decision.

--- TASK ---
$TASK"

TS="$(date +%Y%m%dT%H%M%S)"
RUN="${PAIR_RUN_DIR:-$STATE/runs/$TS-$FROM-$TARGET-$MODE}"
mkdir -p "$RUN"
printf '%s\n' "$PROMPT" > "$RUN/prompt.md"
RESULT="$RUN/result.md"
snapshot() {
  git status --porcelain -uall 2>/dev/null | cut -c4- | sed 's/.* -> //' | while IFS= read -r f; do
    printf '%s\t%s\n' "$f" "$(git hash-object -- "$f" 2>/dev/null || echo deleted)"
  done | sort
}
BEFORE=""; [ $IS_GIT -eq 1 ] && BEFORE="$(snapshot || true)"

echo "pair: $FROM -> $TARGET ($MODE$([ $WRITE -eq 1 ] && echo ', write')) in $REPO" >&2
echo "pair: run log $RUN" >&2

SESSION_ID=""; STATUS="ok"
CLEAN_ENV=(env -u CLAUDECODE -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_CHILD_SESSION \
  -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_MESSAGING_SOCKET -u CLAUDE_CODE_MESSAGING_TOKEN \
  -u CLAUDE_PID -u CLAUDE_CODE_SESSION_ATTENDED -u CLAUDE_EFFORT)

if [ "$TARGET" = "claude" ]; then
  ARGS=(-p --output-format json)
  if [ $WRITE -eq 1 ]; then
    ARGS+=(--permission-mode auto)
  else
    ARGS+=(--permission-mode dontAsk --allowedTools
      "Read" "Grep" "Glob" "WebSearch" "WebFetch"
      "Bash(git diff:*)" "Bash(git log:*)" "Bash(git status:*)" "Bash(git show:*)"
      "Bash(ls:*)" "Bash(cat:*)" "Bash(grep:*)" "Bash(rg:*)" "Bash(find:*)" "Bash(wc:*)" "Bash(head:*)" "Bash(tail:*)")
  fi
  [ -n "$RESUME_ID" ] && ARGS+=(--resume "$RESUME_ID")
  if printf '%s' "$PROMPT" | "${CLEAN_ENV[@]}" claude "${ARGS[@]}" > "$RUN/out.json" 2> "$RUN/stderr.log"; then :; else STATUS="error"; fi
  if jq -e . "$RUN/out.json" >/dev/null 2>&1; then
    jq -r '.result // empty' "$RUN/out.json" > "$RESULT"
    SESSION_ID="$(jq -r '.session_id // empty' "$RUN/out.json")"
    [ "$(jq -r '.is_error // false' "$RUN/out.json")" = "true" ] && STATUS="error"
  else
    cp "$RUN/out.json" "$RESULT" 2>/dev/null || true
  fi
else
  if [ -n "$RESUME_ID" ]; then
    ARGS=(exec resume "$RESUME_ID")
  else
    ARGS=(exec -C "$REPO")
  fi
  ARGS+=(--json -o "$RESULT" --skip-git-repo-check)
  if [ $WRITE -eq 1 ]; then ARGS+=(--approve-for-me); else ARGS+=(-s read-only); fi
  ARGS+=(-)
  if printf '%s' "$PROMPT" | "${CLEAN_ENV[@]}" codex "${ARGS[@]}" > "$RUN/events.jsonl" 2> "$RUN/stderr.log"; then :; else STATUS="error"; fi
  SESSION_ID="$(jq -r 'select(.type=="thread.started") | .thread_id // empty' "$RUN/events.jsonl" 2>/dev/null | head -n1 || true)"
  [ -n "$SESSION_ID" ] || SESSION_ID="$RESUME_ID"
fi

if [ ! -s "$RESULT" ]; then
  STATUS="error"
  {
    echo "(no final message from $TARGET)"
    [ -f "$RUN/events.jsonl" ] && jq -r 'select(.type=="error") | "error: \(.message)"' "$RUN/events.jsonl" 2>/dev/null | tail -n 3
    [ -f "$RUN/out.json" ] && head -c 2000 "$RUN/out.json"
    tail -n 20 "$RUN/stderr.log"
  } > "$RESULT"
fi

CHANGED=""
if [ $IS_GIT -eq 1 ] && [ $WRITE -eq 1 ]; then
  AFTER="$(snapshot || true)"
  CHANGED="$( { comm -13 <(printf '%s\n' "$BEFORE") <(printf '%s\n' "$AFTER");
                comm -23 <(printf '%s\n' "$BEFORE") <(printf '%s\n' "$AFTER"); } \
              | cut -f1 | grep -v -e '__pycache__/' -e '\.pyc$' -e '^$' | sort -u || true)"
fi

jq -cn --arg ts "$TS" --arg from "$FROM" --arg to "$TARGET" --arg mode "$MODE" \
  --argjson write "$WRITE" --arg repo "${PAIR_MAIN_REPO:-$REPO}" --arg status "$STATUS" \
  --arg session_id "$SESSION_ID" --arg resumed "$RESUME_ID" \
  --arg transcript "$TRANSCRIPT" --arg brief_head "$(printf '%s' "${BRIEF:-review}" | head -n1 | cut -c1-140)" \
  --arg result_file "$RESULT" --arg run "$RUN" --arg changed "$CHANGED" \
  --arg parallel_id "${PAIR_PARALLEL_ID:-}" \
  '{ts:$ts,from:$from,to:$to,mode:(if $parallel_id != "" then "parallel" else $mode end),parallel_id:$parallel_id,
    write:($write==1),repo:$repo,status:$status,
    session_id:$session_id,resumed_from:$resumed,main_transcript:$transcript,
    brief_head:$brief_head,files_changed:($changed|split("\n")|map(select(.!=""))),
    result_file:$result_file,run_dir:$run}' >> "$LEDGER"

echo "===== $TARGET ($MODE) [$STATUS] ====="
cat "$RESULT"
if [ -n "$CHANGED" ]; then
  echo
  echo "===== files changed by $TARGET ====="
  printf '%s\n' "$CHANGED"
  echo "(inspect with: git diff)"
fi
[ -n "$SESSION_ID" ] && echo && echo "(session $SESSION_ID; follow up with: pair $MODE $TARGET --continue \"...\")"
[ "$STATUS" = "ok" ]
